# Wartosci deweloperskie. Skopiuj do .env (poza repo); bez prawdziwych sekretow.
POSTGRES_USER=knowledgeops
POSTGRES_PASSWORD=knowledgeops
POSTGRES_DB=knowledgeops
POSTGRES_PORT=5433
DATABASE_URL=postgresql://knowledgeops:knowledgeops@127.0.0.1:5433/knowledgeops
# Dla uruchomien z hosta (poza kontenerem): katalog z danymi TechQA.
# TECHQA_DIR=./data/raw/techqa

# Odpowiedzi z cytatami: model czatu OpenAI. Bez OPENAI_API_KEY endpoint odpowiedzi
# zwraca blad konfiguracji (model_not_configured). Sekret trzymaj tylko w .env.
# OPENAI_API_KEY=
# Inny dostawca zgodny z OpenAI, np. OpenRouter (klucz OpenRouter w OPENAI_API_KEY):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# CHAT_MODEL=deepseek/deepseek-v4.1-flash
# CHAT_REASONING_EFFORT=none   # none wylacza rozumowanie (limit 12 s jest ciasny)
# Gemini (endpoint zgodny z OpenAI; klucz Gemini w OPENAI_API_KEY):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CHAT_MODEL=gemini-3.8-flash
# CHAT_REASONING_EFFORT=low
# Maly model z obsluga strict structured output; zweryfikuj w aktualnej ofercie OpenAI.
CHAT_MODEL=gpt-6-luna
# Wysilek rozumowania ("low" przyspiesza odpowiedz); pusty = parametr nie jest wysylany.
CHAT_REASONING_EFFORT=low
# Limit jednego wywolania modelu i calego zapytania (sekundy).
CHAT_TIMEOUT_S=12
ANSWER_DEADLINE_S=25
# Langfuse Cloud: slad kazdego zapytania. Bez kluczy slad jest wylaczony.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
